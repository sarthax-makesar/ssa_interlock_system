# -------------------------------------------------------------------------
# 1. Define Primary Hardware Clocks (Based on input pins)
# -------------------------------------------------------------------------

# Fast RF ADC sampling clock (100 MHz = 10.0ns period)
create_clock -name clk_fast -period 10.000 [get_ports {clk_fast_pin}]

# Central System/SoC Processing clock (50 MHz = 20.0ns period)
create_clock -name clk_sys -period 20.000 [get_ports {clk_sys_pin}]

# Slow Telemetry bus monitor clock (10 MHz = 100.0ns period)
create_clock -name clk_telemetry -period 100.000 [get_ports {clk_telemetry_pin}]

# -------------------------------------------------------------------------
# 2. Handle Asynchronous Clock Domain Crossing (CDC) boundaries
# -------------------------------------------------------------------------
# Tell the Quartus TimeQuest analyzer that these three domains are completely 
# asynchronous so it doesn't waste routing resources calculating false setups.
set_clock_groups -asynchronous \
    -group {clk_fast} \
    -group {clk_sys} \
    -group {clk_telemetry}

# -------------------------------------------------------------------------
# 3. Apply Strict Latency Constraints to Safety Actuators
# -------------------------------------------------------------------------
# The ultra-fast RF gate output pin must clear within 15ns of a trip being 
# calculated inside the clk_fast domain to stay safely under our 100ns budget.
set_max_delay -from [get_registers {*fast_comparator_core*|trip_fast}] -to [get_ports {rf_gate_disable_pin}] 15.000
set_min_delay -from [get_registers {*fast_comparator_core*|trip_fast}] -to [get_ports {rf_gate_disable_pin}] 0.000